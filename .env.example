# Cloud sync (optional, phase 5).
# Leave both empty to run LayerCost in local-only mode.
# Local Supabase: copy API_URL and PUBLISHABLE_KEY from `npx supabase status -o env`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google login (optional, ADR-0025). Public flag, not a secret.
# Set to true only after the Google provider works in Supabase.
VITE_AUTH_GOOGLE_ENABLED=false

# Public Formspree endpoint for the "request access" page (ADR-0026).
# Not a secret. Leave empty to show the form as unavailable.
# Local development should use a separate test form; production uses the real
# form restricted to layercost.vercel.app.
VITE_ACCESS_REQUEST_ENDPOINT=

# Backward-compatible fallback for projects that still use the anon key.
# VITE_SUPABASE_ANON_KEY=
