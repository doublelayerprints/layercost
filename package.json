{
  "name": "layercost",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run budget",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "node scripts/test-auth-e2e.mjs",
    "test:e2e:sync": "node scripts/test-sync-e2e.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "capture:landing": "node scripts/capture-landing.mjs",
    "test:visual": "npm run build && playwright test tests/e2e/visual.spec.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local | prettier --parser typescript > src/data/cloud/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
